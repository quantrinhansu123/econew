{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "cd client && pnpm install --frozen-lockfile",
  "buildCommand": "cd client && pnpm build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/hrm",
      "destination": "/hrm/index.html"
    },
    {
      "source": "/hrm/((?!assets/).*)",
      "destination": "/hrm/index.html"
    },
    {
      "source": "/((?!hrm/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/hrm/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
